{
  "name": "same-day-reconnect",
  "description": "A cable disconnect and reconnect on the same day starts a new independent charging session and creates a fresh charging plan.",
  "now": "2026-07-07T18:00:00+02:00",
  "fixture": "cheap-night",
  "initial": {
    "devices": {
      "mercedes": {
        "capabilitiesObj": {
          "measure_battery": 62
        }
      },
      "plug": {
        "capabilitiesObj": {
          "onoff": false,
          "measure_power": 0
        }
      }
    }
  },
  "steps": [
    {
      "flow": "start-session",
      "now": "2026-07-07T18:00:00+02:00",
      "expect": {
        "result": {
          "started": true,
          "sessionId": "2026-07-07 18:00:00",
          "loggerWritten": true
        },
        "events": ["session_start"],
        "logic": {
          "ChargeConnectedAt": "2026-07-07 18:00:00",
          "SmartChargeShouldCharge": false,
          "SmartChargeReason": "Session started"
        }
      }
    },
    {
      "flow": "run-decision",
      "now": "2026-07-07T18:05:00+02:00",
      "expect": {
        "result": {
          "shouldChargeNow": false,
          "plannedStart": "2026-07-08 02:00:00",
          "plannedEnd": "2026-07-08 04:00:00"
        },
        "reasonIncludes": "Waiting for selected charging plan",
        "events": ["smartcharge_decision"],
        "plugOn": false,
        "plugCommandCount": 0,
        "tibberCallsDelta": 1
      }
    },
    {
      "flow": "reset-session",
      "now": "2026-07-07T18:20:00+02:00",
      "expect": {
        "result": {
          "reset": true,
          "loggerWritten": true
        },
        "events": ["session_reset"],
        "plugOn": false,
        "logic": {
          "ChargeConnectedAt": "null",
          "SmartChargeShouldCharge": false
        }
      }
    },
    {
      "flow": "start-session",
      "now": "2026-07-07T20:15:00+02:00",
      "set": {
        "devices": {
          "mercedes": {
            "capabilitiesObj": {
              "measure_battery": 62
            }
          },
          "plug": {
            "capabilitiesObj": {
              "onoff": false,
              "measure_power": 0
            }
          }
        }
      },
      "expect": {
