{
  "name": "runtime-mercedes-preconditioning",
  "description": "Preconditioning cannot keep the plug on while the production planner requests waiting.",
  "now": "2026-07-07T18:05:00+02:00",
  "initial": {
    "logic": {
      "ChargeConnectedAt": "2026-07-07 17:00:00",
      "SmartChargeRuntimeMode": "active",
      "SmartChargeShouldCharge": false
    },
    "devices": {
      "mercedes": {
        "capabilitiesObj": {
          "measure_battery": 84,
          "text_charging_status": "Charge break",
          "onoff_charging": false,
          "measure_charge_power": 0,
          "onoff_precond": true
        }
      },
      "plug": {
        "capabilitiesObj": {
          "onoff": false,
          "measure_power": 0
        }
      }
    }
  },
  "steps": [
    {
      "flow": "runtime-controller",
      "expect": {
        "result": {
          "preconditioningCapability": "onoff_precond",
          "preconditioningRawValue": true,
          "plannerShouldCharge": false,
          "desiredPlugState": false,
          "action": "none"
        },
        "events": ["smartcharge_decision"],
        "plugOn": false,
        "plugCommandCount": 0
      }
    },
    {
      "flow": "runtime-controller",
      "set": {
        "devices": {
          "plug": {
            "capabilitiesObj": {
              "onoff": true
            }
          }
        }
      },
      "expect": {
        "result": {
          "plannerShouldCharge": false,
          "desiredPlugState": false,
          "action": "switched_off"
        },
        "events": [
          "smartcharge_decision",
          "actuator_request",
          "smartcharge_off"
        ],
        "plugOn": false,
        "plugCommandCount": 1
      }
    }
